{
  "rules": {
    "gameStates": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.hasChildren(['lat', 'lng', 'latitude', 'longitude', 'location', 'gps', 'coordinates'])"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && newData.child('fromUserId').val() === auth.uid && newData.child('toUserId').val() === $uid"
      }
    },
    "webrtc_signaling": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    ".read": false,
    ".write": false
  }
}
