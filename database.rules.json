{
  "rules": {
    "gameStates": {
      "$gameId": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    ".read": false,
    ".write": false
  }
}
