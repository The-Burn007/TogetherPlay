{
  "rules": {
    "gameStates": {
      "$gameId": {
        ".read": "auth != null && (data.child('scores').hasChild(auth.uid) || data.child('playerIds/0').val() === auth.uid || data.child('playerIds/1').val() === auth.uid || data.child('playerIds').hasChild(auth.uid) || data.child('allowedPlayers').hasChild(auth.uid))",
        ".write": false
      }
    },
    "privateGameStates": {
      ".read": false,
      ".write": false,
      "$gameId": {
        ".read": false,
        ".write": false
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || data.child('partnerId').val() === auth.uid || data.child('authorizedUsers').hasChild(auth.uid) || (data.child('coupleId').exists() && root.child('couples').child(data.child('coupleId').val()).child('memberIds').hasChild(auth.uid)))",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "(!newData.hasChild('userId') || (newData.child('userId').isString() && newData.child('userId').val() === $uid)) && (!newData.hasChild('partnerId') || (newData.child('partnerId').isString() && newData.child('partnerId').val() !== $uid && newData.child('partnerId').val().length <= 128)) && (!newData.hasChild('authorizedUsers') || newData.child('authorizedUsers').hasChild($uid)) && (!newData.hasChild('lastSeenMs') || newData.child('lastSeenMs').val() === now) && !newData.hasChild('lat') && !newData.hasChild('lng') && !newData.hasChild('latitude') && !newData.hasChild('longitude') && !newData.hasChild('location') && !newData.hasChild('gps') && !newData.hasChild('coordinates')"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && newData.child('fromUserId').val() === auth.uid && newData.child('toUserId').val() === $uid",
        ".validate": "newData.hasChildren(['id', 'type', 'title', 'body', 'timestamp']) && newData.child('title').isString() && newData.child('title').val().length <= 120 && newData.child('body').isString() && newData.child('body').val().length <= 500"
      }
    },
    "webrtc_signaling": {
      "$roomId": {
        ".read": "auth != null && (data.child('authorizedUsers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('allowedPlayers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('playerIds').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('playerIds/0').val() === auth.uid || root.child('gameStates').child($roomId).child('playerIds/1').val() === auth.uid)",
        "authorizedUsers": {
          ".read": "auth != null && (data.hasChild(auth.uid) || root.child('gameStates').child($roomId).child('allowedPlayers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('playerIds').hasChild(auth.uid))",
          ".write": false
        },
        "participants": {
          ".read": "auth != null && (data.parent().child('authorizedUsers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('allowedPlayers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('playerIds').hasChild(auth.uid))",
          "$userId": {
            ".read": "auth != null && (auth.uid === $userId || data.parent().parent().child('authorizedUsers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('allowedPlayers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('playerIds').hasChild(auth.uid))",
            ".write": "auth != null && auth.uid === $userId && (data.parent().parent().child('authorizedUsers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('allowedPlayers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('playerIds').hasChild(auth.uid))",
            ".validate": "!newData.exists() || (newData.hasChildren(['userId', 'joinedAt']) && newData.child('userId').val() === $userId && newData.child('userId').isString() && newData.child('userId').val().length <= 128)"
          }
        },
        "offers": {
          ".read": "auth != null && (data.parent().child('authorizedUsers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('allowedPlayers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('playerIds').hasChild(auth.uid))",
          "$toUserId": {
            ".read": "auth != null && (auth.uid === $toUserId || data.child('fromUserId').val() === auth.uid)",
            ".write": "auth != null && (data.parent().parent().child('authorizedUsers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('allowedPlayers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('playerIds').hasChild(auth.uid)) && (!newData.exists() ? (data.child('fromUserId').val() === auth.uid || auth.uid === $toUserId) : (newData.child('fromUserId').val() === auth.uid && auth.uid !== $toUserId && (data.parent().parent().child('authorizedUsers').hasChild($toUserId) || root.child('gameStates').child($roomId).child('allowedPlayers').hasChild($toUserId) || root.child('gameStates').child($roomId).child('playerIds').hasChild($toUserId))))",
            ".validate": "!newData.exists() || (newData.hasChildren(['fromUserId', 'toUserId']) && newData.child('toUserId').val() === $toUserId && newData.child('fromUserId').val() === auth.uid && (newData.child('type').val() === 'offer' || newData.child('sdp/type').val() === 'offer') && ((newData.child('sdp').isString() && newData.child('sdp').val().length <= 32768) || (newData.child('sdp/sdp').isString() && newData.child('sdp/sdp').val().length <= 32768)))"
          }
        },
        "answers": {
          ".read": "auth != null && (data.parent().child('authorizedUsers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('allowedPlayers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('playerIds').hasChild(auth.uid))",
          "$toUserId": {
            ".read": "auth != null && (auth.uid === $toUserId || data.child('fromUserId').val() === auth.uid)",
            ".write": "auth != null && (data.parent().parent().child('authorizedUsers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('allowedPlayers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('playerIds').hasChild(auth.uid)) && (!newData.exists() ? (data.child('fromUserId').val() === auth.uid || auth.uid === $toUserId) : (newData.child('fromUserId').val() === auth.uid && auth.uid !== $toUserId && (data.parent().parent().child('authorizedUsers').hasChild($toUserId) || root.child('gameStates').child($roomId).child('allowedPlayers').hasChild($toUserId) || root.child('gameStates').child($roomId).child('playerIds').hasChild($toUserId))))",
            ".validate": "!newData.exists() || (newData.hasChildren(['fromUserId', 'toUserId']) && newData.child('toUserId').val() === $toUserId && newData.child('fromUserId').val() === auth.uid && (newData.child('type').val() === 'answer' || newData.child('sdp/type').val() === 'answer') && ((newData.child('sdp').isString() && newData.child('sdp').val().length <= 32768) || (newData.child('sdp/sdp').isString() && newData.child('sdp/sdp').val().length <= 32768)))"
          }
        },
        "candidates": {
          ".read": "auth != null && (data.parent().child('authorizedUsers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('allowedPlayers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('playerIds').hasChild(auth.uid))",
          "$toUserId": {
            ".read": "auth != null && (auth.uid === $toUserId || data.child('fromUserId').val() === auth.uid)",
            ".write": "auth != null && (data.parent().parent().child('authorizedUsers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('allowedPlayers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('playerIds').hasChild(auth.uid)) && (!newData.exists() || (auth.uid !== $toUserId && (data.parent().parent().child('authorizedUsers').hasChild($toUserId) || root.child('gameStates').child($roomId).child('allowedPlayers').hasChild($toUserId) || root.child('gameStates').child($roomId).child('playerIds').hasChild($toUserId))))",
            "$candidateId": {
              ".write": "auth != null && (data.parent().parent().parent().child('authorizedUsers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('allowedPlayers').hasChild(auth.uid) || root.child('gameStates').child($roomId).child('playerIds').hasChild(auth.uid)) && (!newData.exists() || (newData.child('fromUserId').val() === auth.uid && auth.uid !== $toUserId))",
              ".validate": "!newData.exists() || (newData.hasChildren(['fromUserId', 'toUserId']) && newData.child('toUserId').val() === $toUserId && newData.child('fromUserId').val() === auth.uid && ((newData.child('candidate').isString() && newData.child('candidate').val().length <= 2048) || (newData.child('candidate/candidate').isString() && newData.child('candidate/candidate').val().length <= 2048)))"
            }
          }
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
