{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with display name and couple membership pointer",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "displayName": {
          "type": "string",
          "description": "User visible name",
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar photo URL"
        },
        "coupleId": {
          "type": "string",
          "description": "ID of the couple space the user belongs to"
        },
        "timezone": {
          "type": "string",
          "description": "User timezone identifier"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation"
        },
        "lastActiveAt": {
          "type": "string",
          "description": "ISO timestamp of last activity"
        },
        "status": {
          "type": "string",
          "enum": ["active", "disabled"]
        }
      },
      "required": ["uid", "displayName", "createdAt", "status"]
    },
    "Couple": {
      "title": "Couple",
      "description": "A private relationship sanctuary space shared between exactly two partners",
      "type": "object",
      "properties": {
        "coupleId": {
          "type": "string",
          "description": "Unique couple document identifier"
        },
        "memberIds": {
          "type": "array",
          "description": "Array of member UIDs (maximum 2 members in MVP)"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the partner who created the space"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of couple space creation"
        },
        "relationshipStartDate": {
          "type": "string",
          "description": "ISO date string or custom date for couple anniversary"
        },
        "status": {
          "type": "string",
          "enum": ["active", "deleted"]
        }
      },
      "required": ["coupleId", "memberIds", "ownerId", "createdAt", "status"]
    },
    "CoupleInvite": {
      "title": "CoupleInvite",
      "description": "Secure invitation record storing hashed token for partner joining",
      "type": "object",
      "properties": {
        "inviteId": {
          "type": "string",
          "description": "Unique invitation identifier"
        },
        "coupleId": {
          "type": "string",
          "description": "Couple ID for which this invitation is issued"
        },
        "inviterId": {
          "type": "string",
          "description": "UID of the inviting partner"
        },
        "inviterName": {
          "type": "string",
          "description": "Display name of the inviting partner"
        },
        "tokenHash": {
          "type": "string",
          "description": "SHA-256 cryptographic hash of the raw invite secret"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "expired", "revoked"]
        },
        "expiresAt": {
          "type": "string",
          "description": "ISO timestamp when the invite expires"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of invite creation"
        },
        "acceptedBy": {
          "type": "string",
          "description": "UID of the accepting partner"
        }
      },
      "required": ["inviteId", "coupleId", "inviterId", "tokenHash", "status", "createdAt"]
    },
    "GameSession": {
      "title": "GameSession",
      "description": "Authoritative durable game session managed strictly by the server",
      "type": "object",
      "properties": {
        "gameId": {
          "type": "string",
          "description": "Unique game session ID"
        },
        "coupleId": {
          "type": "string",
          "description": "Couple ID owning this game session"
        },
        "gameType": {
          "type": "string",
          "description": "Type identifier of the game"
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "ready", "countdown", "playing", "round_end", "game_end", "results"]
        },
        "playerIds": {
          "type": "array",
          "description": "List of player UIDs participating in the game"
        },
        "createdBy": {
          "type": "string",
          "description": "UID of the player who created the session"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "startedAt": {
          "type": "string",
          "description": "ISO timestamp when game commenced"
        },
        "endedAt": {
          "type": "string",
          "description": "ISO timestamp when game concluded"
        },
        "winnerId": {
          "type": "string",
          "description": "UID of winner or null if tie"
        },
        "schemaVersion": {
          "type": "number",
          "description": "Schema format version"
        }
      },
      "required": ["gameId", "coupleId", "gameType", "status", "playerIds", "createdBy", "createdAt", "schemaVersion"]
    },
    "GameResult": {
      "title": "GameResult",
      "description": "Authoritative durable completed game result and relational memory",
      "type": "object",
      "properties": {
        "resultId": {
          "type": "string",
          "description": "Unique result record identifier"
        },
        "gameId": {
          "type": "string",
          "description": "Associated game session identifier"
        },
        "coupleId": {
          "type": "string",
          "description": "Couple ID"
        },
        "gameType": {
          "type": "string",
          "description": "Game type"
        },
        "playerIds": {
          "type": "array",
          "description": "List of participant player UIDs"
        },
        "winnerId": {
          "type": "string",
          "description": "UID of winning partner or null"
        },
        "durationSeconds": {
          "type": "number",
          "description": "Authoritative session duration in seconds"
        },
        "totalRounds": {
          "type": "number",
          "description": "Total rounds played"
        },
        "startedAt": {
          "type": "string",
          "description": "ISO timestamp of start"
        },
        "completedAt": {
          "type": "string",
          "description": "ISO timestamp of completion"
        },
        "serverTimestamp": {
          "type": "number",
          "description": "Server epoch millisecond timestamp"
        }
      },
      "required": ["resultId", "gameId", "coupleId", "gameType", "playerIds", "durationSeconds", "totalRounds", "startedAt", "completedAt", "serverTimestamp"]
    },
    "CoupleMemory": {
      "title": "CoupleMemory",
      "description": "Private relationship memory artifact for couples, including photos, game moments, milestones, and notes",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique memory identifier"
        },
        "coupleId": {
          "type": "string",
          "description": "Couple ID owning this memory"
        },
        "type": {
          "type": "string",
          "enum": ["photo", "game_moment", "milestone", "relationship_date", "note"]
        },
        "title": {
          "type": "string",
          "description": "Memory headline or title",
          "maxLength": 120
        },
        "date": {
          "type": "string",
          "description": "ISO date string of the memory"
        },
        "dateLabel": {
          "type": "string",
          "description": "Formatted date label for timeline"
        },
        "context": {
          "type": "string",
          "description": "Intimate relationship context or location",
          "maxLength": 600
        },
        "note": {
          "type": "string",
          "description": "Optional detailed reflection or letters",
          "maxLength": 3000
        },
        "gameActivity": {
          "type": "object",
          "description": "Associated game details if memory type is game_moment"
        },
        "media": {
          "type": "object",
          "description": "Private media metadata stored under couples/{coupleId}/memories/{fileName}"
        },
        "milestoneData": {
          "type": "object",
          "description": "Milestone details if memory type is milestone"
        },
        "relationshipDateData": {
          "type": "object",
          "description": "Relationship date details if memory type is relationship_date"
        },
        "createdBy": {
          "type": "string",
          "description": "UID of author partner"
        },
        "authorName": {
          "type": "string",
          "description": "Display name of author partner"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO update timestamp"
        }
      },
      "required": ["id", "coupleId", "type", "title", "date", "context", "createdBy", "createdAt"]
    },
    "RateLimitRecord": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Rate limit identifier key"
        },
        "timestamps": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Sliding window timestamp reservations"
        },
        "ip": {
          "type": "string",
          "description": "Client IP address for network-tier protection"
        },
        "updatedAt": {
          "type": "number",
          "description": "Epoch timestamp of last update"
        },
        "expiresAt": {
          "type": "number",
          "description": "Epoch timestamp when current window expires"
        }
      },
      "required": ["key", "timestamps", "updatedAt", "expiresAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profile documents keyed by user UID"
    },
    "/couples/{coupleId}": {
      "schema": "Couple",
      "description": "Private sanctuary spaces for couples (max 2 members)"
    },
    "/coupleInvites/{inviteId}": {
      "schema": "CoupleInvite",
      "description": "One-way hashed invitation tokens for pairing partners"
    },
    "/games/{gameId}": {
      "schema": "GameSession",
      "description": "Durable authoritative game records (read-only for clients, server managed)"
    },
    "/gameResults/{resultId}": {
      "schema": "GameResult",
      "description": "Durable completed game results (read-only for clients, server managed)"
    },
    "/couples/{coupleId}/memories/{memoryId}": {
      "schema": "CoupleMemory",
      "description": "Private couple visual archive and relationship memory artifacts"
    },
    "/rateLimits/{rateLimitId}": {
      "schema": "RateLimitRecord",
      "description": "Shared server-authoritative rate limiter documents across server instances"
    }
  }
}
