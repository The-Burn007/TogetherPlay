rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Pillar 1): Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function coupleExists(coupleId) {
      return exists(/databases/$(database)/documents/couples/$(coupleId));
    }

    function isCoupleMember(coupleId) {
      return signedIn()
        && coupleExists(coupleId)
        && request.auth.uid in get(
          /databases/$(database)/documents/couples/$(coupleId)
        ).data.memberIds;
    }

    function isPartnerOf(targetUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(targetUid))
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(targetUid)).data.coupleId != null
        && get(/databases/$(database)/documents/users/$(targetUid)).data.coupleId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId;
    }

    match /users/{uid} {
      // User can read own profile or their connected partner's profile
      allow read: if isSelf(uid) || isPartnerOf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'coupleId', 'timezone', 'createdAt', 'lastActiveAt', 'status']);
      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);
      allow delete: if isSelf(uid);
    }

    match /couples/{coupleId} {
      // Security Requirement: User A must never access another couple
      allow read: if isCoupleMember(coupleId);

      // Creation: Creator initiates a couple as single initial member
      allow create: if signedIn()
        && request.resource.data.coupleId == coupleId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.status == "active";

      // Updates: Existing couple member updating settings
      // SECURITY MANDATE: memberIds is strictly IMMUTABLE from client updates.
      // Partner joining is handled exclusively by authoritative server transaction via /api/couples/accept-invite.
      allow update: if isCoupleMember(coupleId)
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.coupleId == resource.data.coupleId;

      allow delete: if false;
    }

    match /coupleInvites/{inviteId} {
      // User can fetch an invite to preview; list restricted to inviter
      allow get: if signedIn();
      allow list: if signedIn()
        && resource.data.inviterId == request.auth.uid;

      // No plaintext secrets allowed in documents; requires 64-char SHA256 hex hash
      allow create: if signedIn()
        && request.resource.data.inviteId == inviteId
        && request.resource.data.inviterId == request.auth.uid
        && request.resource.data.tokenHash is string
        && request.resource.data.tokenHash.size() == 64
        && !('rawToken' in request.resource.data)
        && !('secret' in request.resource.data)
        && request.resource.data.status == "pending"
        && isCoupleMember(request.resource.data.coupleId);

      // Inviter can revoke their pending invite; partner joining runs via authoritative server
      allow update: if signedIn()
        && resource.data.inviterId == request.auth.uid
        && request.resource.data.status == "revoked"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow delete: if false;
    }

    match /games/{gameId} {
      // Direct game state mutation is forbidden: client cannot modify game state directly
      allow read: if signedIn()
        && request.auth.uid in resource.data.playerIds;
      allow create, update, delete: if false;
    }

    match /games/{gameId}/events/{eventId} {
      allow read: if signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/games/$(gameId)
        ).data.playerIds;
      allow write: if false;
    }

    match /gameResults/{resultId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.playerIds;
      allow write: if false;
    }

    match /couples/{coupleId}/memories/{memoryId} {
      // 1. Read: Allowed strictly to verified members of this couple
      allow read: if isCoupleMember(coupleId);

      // 2. Create: Allowed only for couple members where author is the creator
      // IMMUTABLE on creation: memoryId, coupleId, createdBy, createdAt, original storage reference
      allow create: if isCoupleMember(coupleId)
        && request.resource.data.id == memoryId
        && request.resource.data.coupleId == coupleId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is string
        && request.resource.data.date is string
        // If media is attached, storagePath must be within this couple's memories namespace
        // and cannot contain path traversal sequences ('..')
        && (!('media' in request.resource.data) || request.resource.data.media == null
            || (request.resource.data.media.storagePath is string
                && request.resource.data.media.storagePath.matches('^couples/' + coupleId + '/memories/.*')
                && !request.resource.data.media.storagePath.matches('.*\\.\\..*')));

      // 3. Update: Strict immutability for core fields; only controlled updates allowed
      // A couple member CANNOT:
      // - change memory ID
      // - change couple ID
      // - change creator (createdBy)
      // - change ownership
      // - forge/mutate creation timestamp (createdAt)
      // - replace another member's original storage reference (media.storagePath)
      //
      // Allowed updates are strictly CONTROLLED:
      // - caption, reaction, reactions, visibility, note, title, context, dateLabel, updatedAt, media
      allow update: if isCoupleMember(coupleId)
        // Core immutability
        && request.resource.data.id == resource.data.id
        && request.resource.data.coupleId == resource.data.coupleId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        // Original storage reference and filename cannot be replaced or hijacked
        && (!('media' in resource.data) || resource.data.media == null
            || (request.resource.data.media != null
                && request.resource.data.media.storagePath == resource.data.media.storagePath
                && request.resource.data.media.fileName == resource.data.media.fileName))
        // Controlled update boundaries
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['caption', 'reaction', 'reactions', 'visibility', 'note', 'title', 'context', 'dateLabel', 'updatedAt', 'media']);

      // 4. Delete: Strictly unauthorized unless requested by the creator who authored the memory
      allow delete: if isCoupleMember(coupleId)
        && resource.data.createdBy == request.auth.uid;
    }

    match /couples/{coupleId}/aiChallenges/{challengeId} {
      allow read: if isCoupleMember(coupleId);
      allow write: if false;
    }

    match /rateLimits/{rateLimitId} {
      // Server-authoritative rate limits: direct client access is strictly forbidden
      allow read, write: if false;
    }
  }
}
