rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function coupleExists(coupleId) {
      return exists(/databases/$(database)/documents/couples/$(coupleId));
    }

    function isCoupleMember(coupleId) {
      return signedIn()
        && coupleExists(coupleId)
        && request.auth.uid in get(
          /databases/$(database)/documents/couples/$(coupleId)
        ).data.memberIds;
    }

    function isPartnerOf(targetUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(targetUid))
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(targetUid)).data.coupleId != null
        && get(/databases/$(database)/documents/users/$(targetUid)).data.coupleId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId;
    }

    match /users/{uid} {
      // User can read own profile or their connected partner's profile
      allow read: if isSelf(uid) || isPartnerOf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isSelf(uid);
    }

    match /couples/{coupleId} {
      // Security Requirement: User A must never access another couple
      allow read: if isCoupleMember(coupleId);

      // Creation: Creator initiates a couple as single initial member
      allow create: if signedIn()
        && request.resource.data.coupleId == coupleId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.status == "active";

      // Updates:
      // Branch 1: Existing member updating non-membership settings
      // Branch 2: Second partner joining with invitation
      // Enforces:
      // - A couple must never contain more than two members
      // - A user cannot add arbitrary third-party users (can only add self)
      allow update: if (
        // Branch 1: Couple member updating settings (membership immutable)
        (
          isCoupleMember(coupleId)
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.coupleId == resource.data.coupleId
        )
        ||
        // Branch 2: Partner accepting invitation and joining
        (
          signedIn()
          && resource.data.memberIds.size() == 1
          && request.resource.data.memberIds.size() == 2
          && request.resource.data.memberIds[0] == resource.data.memberIds[0]
          && request.resource.data.memberIds[1] == request.auth.uid
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.coupleId == resource.data.coupleId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status == "active"
        )
      );

      allow delete: if false;
    }

    match /coupleInvites/{inviteId} {
      // User can fetch an invite to preview/accept; list restricted to inviter
      allow get: if signedIn();
      allow list: if signedIn()
        && resource.data.inviterId == request.auth.uid;

      // No plaintext secrets allowed in documents; requires 64-char SHA256 hex hash
      allow create: if signedIn()
        && request.resource.data.inviteId == inviteId
        && request.resource.data.inviterId == request.auth.uid
        && request.resource.data.tokenHash is string
        && request.resource.data.tokenHash.size() == 64
        && !('rawToken' in request.resource.data)
        && !('secret' in request.resource.data)
        && request.resource.data.status == "pending"
        && isCoupleMember(request.resource.data.coupleId);

      allow update: if signedIn() && (
        // Inviter can revoke
        (resource.data.inviterId == request.auth.uid
          && request.resource.data.status == "revoked"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        ||
        // Partner accepting invite
        (resource.data.status == "pending"
          && request.resource.data.status == "accepted"
          && request.resource.data.acceptedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy']))
      );

      allow delete: if false;
    }

    match /games/{gameId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.playerIds;
      allow create, update, delete: if false;
    }

    match /games/{gameId}/events/{eventId} {
      allow read: if signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/games/$(gameId)
        ).data.playerIds;
      allow write: if false;
    }

    match /gameResults/{resultId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.playerIds;
      allow write: if false;
    }

    match /couples/{coupleId}/memories/{memoryId} {
      allow read: if isCoupleMember(coupleId);
      allow create: if isCoupleMember(coupleId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isCoupleMember(coupleId)
        && resource.data.createdBy == request.auth.uid;
    }

    match /couples/{coupleId}/aiChallenges/{challengeId} {
      allow read: if isCoupleMember(coupleId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
