rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function coupleExists(coupleId) {
      return exists(/databases/$(database)/documents/couples/$(coupleId));
    }

    function isCoupleMember(coupleId) {
      return signedIn()
        && coupleExists(coupleId)
        && request.auth.uid in get(
          /databases/$(database)/documents/couples/$(coupleId)
        ).data.memberIds;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isSelf(uid);
    }

    match /couples/{coupleId} {
      allow read: if isCoupleMember(coupleId);

      // Creation should normally happen through a callable function.
      // This narrow rule permits only a two-member authenticated couple
      // where the creator is one of the members.
      allow create: if signedIn()
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.ownerId == request.auth.uid;

      // Client updates are restricted to non-membership settings.
      // Membership changes must happen server-side.
      allow update: if isCoupleMember(coupleId)
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if false;
    }

    match /coupleInvites/{inviteId} {
      allow read: if signedIn()
        && resource.data.createdBy == request.auth.uid;

      allow create, update, delete: if false;
    }

    match /games/{gameId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.playerIds;

      allow create, update, delete: if false;
    }

    match /games/{gameId}/events/{eventId} {
      allow read: if signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/games/$(gameId)
        ).data.playerIds;

      allow write: if false;
    }

    match /gameResults/{resultId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.playerIds;

      allow write: if false;
    }

    match /couples/{coupleId}/memories/{memoryId} {
      allow read: if isCoupleMember(coupleId);
      allow create: if isCoupleMember(coupleId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isCoupleMember(coupleId)
        && resource.data.createdBy == request.auth.uid;
    }

    match /couples/{coupleId}/aiChallenges/{challengeId} {
      allow read: if isCoupleMember(coupleId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
